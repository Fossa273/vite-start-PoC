{
  "compilerOptions": {
    "target": "ES2022", // 1. Versión de JavaScript a la que se compila el código.

    "module": "NodeNext", // 2. Sistema de módulos que usará la salida (NodeNext maneja ESM nativo).

    "moduleResolution": "NodeNext", // 3. Estrategia con la que TypeScript busca e importa las librerías/archivos.

    "rootDir": "./src", // 4. Carpeta donde está el código fuente original en TypeScript.

    "outDir": "./dist", // 5. Carpeta donde se guardará el JavaScript ya compilado.

    "sourceMap": true, // 6. Genera archivos .map para poder depurar (debug) el código TS en el navegador.

    "strict": true, // 7. Activa todas las reglas estrictas de comprobación de tipos.

    "esModuleInterop": true, // 8. Permite importar módulos CommonJS como si fueran ES Modules estándar.

    "forceConsistentCasingInFileNames": true, // 9. Obliga a respetar exactamente las mayúsculas/minúsculas en nombres de archivos.

    "skipLibCheck": true, // 10. Omite la revisión de tipos de los archivos de definición (.d.ts) de librerías para acelerar el build.

    "incremental": true // 11. Guarda información de compilaciones previas para recompilar rápido solo lo que cambió.
  },
  "include": ["src/**/*", "tsconfig.json"], // 12. Especifica qué archivos deben ser procesados por el compilador.

  "exclude": ["node_modules", "dist"] // 13. Especifica qué carpetas debe ignorar por completo el compilador.
}
